PORT=5000
MONGODB_URI=mongodb://localhost:27017/ai-study-planner
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI Syllabus Analysis (Ollama — local, free, no external API)
# Install Ollama (https://ollama.com), then start it with `ollama serve` and
# pull a model: `ollama pull qwen2.5:7b-instruct`
# (use qwen2.5:3b-instruct on lighter machines, or llama3.2:3b as a fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=120000
